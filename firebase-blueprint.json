{
  "entities": {
    "Profile": {
      "title": "Profile",
      "description": "A high-level project profile representing a major project entity, often displayed as a story.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "avatarUrl": { "type": "string", "description": "Base64 or URL of the project avatar." },
        "createdAt": { "type": "number" }
      },
      "required": ["name"]
    },
    "Sub": {
      "title": "Sub",
      "description": "A sub-location or sector within a Profile representing the actual workspace for material management.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "profileId": { "type": "string", "description": "Foreign key to the parent Profile." },
        "createdAt": { "type": "number" }
      },
      "required": ["name", "profileId"]
    },
    "StockEntry": {
      "title": "Stock Entry",
      "description": "A record of material inventory currently available at a specific sub-location.",
      "type": "object",
      "properties": {
        "materialName": { "type": "string" },
        "quantity": { "type": "number", "description": "Current quantity in stock." },
        "unit": { "type": "string", "description": "Unit of measurement (e.g., m3, zak, kg)." },
        "dateReceived": { "type": "number", "format": "timestamp" },
        "subId": { "type": "string" }
      },
      "required": ["materialName", "quantity", "unit", "dateReceived"]
    },
    "RAPItem": {
      "title": "RAP Item",
      "description": "Rencana Anggaran Perusahaan (Enterprise Budget Plan) item defining planned material usage.",
      "type": "object",
      "properties": {
        "materialName": { "type": "string" },
        "quantity": { "type": "number", "description": "Total planned budget quantity." },
        "unit": { "type": "string" },
        "totalOrdered": { "type": "number", "description": "Accumulated quantity ordered against this budget item." },
        "locationId": { "type": "string", "description": "Maps to subId." }
      },
      "required": ["materialName", "quantity", "unit", "totalOrdered", "locationId"]
    },
    "MaterialRequest": {
      "title": "Material Request",
      "description": "A formal request for materials linked to a specific sub-location.",
      "type": "object",
      "properties": {
        "materialName": { "type": "string" },
        "quantity": { "type": "number" },
        "unit": { "type": "string" },
        "dateRequested": { "type": "string", "format": "date-time" },
        "dateNeeded": { "type": "string", "format": "date" },
        "subId": { "type": "string", "description": "The unique identifier for the Sub location." },
        "status": { 
          "type": "string", 
          "enum": ["pending", "processing", "awaiting_payment", "paid", "delivered", "received", "on_hold"] 
        },
        "history": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "status": { "type": "string" },
              "timestamp": { "type": "number" }
            }
          }
        },
        "recipient": { "type": "string", "description": "Person who received the material at site." },
        "deliverer": { "type": "string", "description": "Person/Vendor who delivered the material." },
        "createdAt": { "type": "number" },
        "receivedAt": { "type": "number" }
      },
      "required": ["materialName", "quantity", "unit", "dateRequested", "subId", "status", "history"]
    },
    "Notification": {
      "title": "Notification",
      "description": "System-generated notification for real-time alerts across roles.",
      "type": "object",
      "properties": {
        "message": { "type": "string" },
        "timestamp": { "type": "number" },
        "type": { "type": "string", "enum": ["info", "success", "update"] },
        "locationName": { "type": "string" },
        "targetRole": { "type": "string", "enum": ["SM", "SCM", "FINANCE", "RAP", "ALL"] },
        "readBy": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["message", "timestamp", "type", "targetRole", "readBy"]
    },
    "MainMaterial": {
      "title": "Main Material",
      "description": "Master material names available for SM to request.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "unit": { "type": "string" }
      },
      "required": ["name", "unit"]
    },
    "FieldFundEntry": {
      "title": "Field Fund Entry (Nota)",
      "description": "Financial record for field expenditures grouped by invoice (Nota).",
      "type": "object",
      "properties": {
        "subId": { "type": "string" },
        "tanggal": { "type": "string", "format": "date" },
        "notaNo": { "type": "string" },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "uraian": { "type": "string" },
              "klasifikasi": { "type": "string", "enum": ["BAHAN", "ALAT", "JASA"] },
              "jumlah": { "type": "number" },
              "satuan": { "type": "string" },
              "hargaSatuan": { "type": "number" },
              "hargaTotal": { "type": "number" }
            }
          }
        },
        "totalNota": { "type": "number" },
        "keterangan": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["subId", "tanggal", "notaNo", "items", "totalNota", "createdAt"]
    },
    "ReportTemplate": {
      "title": "Report Template",
      "description": "Customizable heading and footer for daily project reports.",
      "type": "object",
      "properties": {
        "subId": { "type": "string" },
        "heading": { "type": "string" },
        "footer": { "type": "string" }
      },
      "required": ["subId", "heading", "footer"]
    },
    "FieldFundDeposit": {
      "title": "Field Fund Deposit",
      "description": "Adjustments (Add/Subtract) to the field fund balance.",
      "type": "object",
      "properties": {
        "subId": { "type": "string" },
        "amount": { "type": "number" },
        "type": { "type": "string", "enum": ["in", "out"] },
        "date": { "type": "string", "format": "date" },
        "createdAt": { "type": "number" }
      },
      "required": ["subId", "amount", "type", "date", "createdAt"]
    }
  },
  "firestore": {
    "mainMaterials": {
      "schema": "MainMaterial",
      "description": "Collection of master material items."
    },
    "fieldFunds": {
      "schema": "FieldFundEntry",
      "description": "Collection of field fund financial records."
    },
    "fieldFundDeposits": {
      "schema": "FieldFundDeposit",
      "description": "Collection of field fund deposits and withdrawals."
    },
    "reportTemplates": {
      "schema": "ReportTemplate",
      "description": "Collection of report structure templates."
    },
    "profiles": {
      "schema": "Profile",
      "description": "Collection of all high-level project profiles."
    },
    "subs": {
      "schema": "Sub",
      "description": "Collection of all project sub-locations."
    },
    "subs/{subId}/stock": {
      "schema": "StockEntry",
      "description": "Nested material inventory records for a specific sub-location."
    },
    "subs/{subId}/rapData": {
      "schema": "RAPItem",
      "description": "Budget plan items specific to a project's sub-location."
    },
    "requests": {
      "schema": "MaterialRequest",
      "description": "Central collection for all material logistics workflows."
    },
    "notifications": {
      "schema": "Notification",
      "description": "Broadcast and targeted alerts for dashboard users."
    }
  }
}
