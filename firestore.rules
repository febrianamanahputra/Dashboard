rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny Catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // 1. HELPERS
    function isSignedIn() {
      // For this app, we allow public access to facilitate role switching in the demo
      // In production, this should be: return request.auth != null;
      return true;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // 2. VALIDATION HELPERS
    function isValidProfile(data) {
      return data.keys().hasAll(['name']) && 
             data.name is string && data.name.size() > 0 && data.name.size() <= 200;
    }

    function isValidSub(data) {
      return data.keys().hasAll(['name', 'profileId']) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
             data.profileId is string && isValidId(data.profileId);
    }

    function isValidStock(data) {
      return data.keys().hasAll(['materialName', 'quantity', 'unit', 'dateReceived']) &&
             data.materialName is string && data.materialName.size() <= 200 &&
             data.quantity is number &&
             data.unit is string && data.unit.size() <= 50;
    }

    function isValidRAPItem(data) {
      return data.keys().hasAll(['materialName', 'quantity', 'unit', 'totalOrdered', 'locationId']) &&
             data.materialName is string && data.materialName.size() <= 200 &&
             data.quantity is number &&
             data.unit is string && data.unit.size() <= 50 &&
             data.locationId is string && isValidId(data.locationId);
    }

    function isValidMaterialRequest(data) {
      return data.keys().hasAll(['materialName', 'quantity', 'unit', 'subId', 'status', 'history']) &&
             data.materialName is string && data.materialName.size() <= 200 &&
             data.quantity is number &&
             data.unit is string && data.unit.size() <= 50 &&
             data.subId is string && isValidId(data.subId) &&
             data.status is string &&
             data.history is list && data.history.size() <= 100;
    }

    function isValidNotification(data) {
      return data.keys().hasAll(['message', 'timestamp', 'targetRole', 'readBy']) &&
             data.message is string && data.message.size() <= 1000 &&
             data.timestamp is number &&
             data.targetRole is string &&
             data.readBy is list;
    }

    function isValidMainMaterial(data) {
      return data.name is string && data.name.size() > 0 &&
             data.unit is string && data.unit.size() > 0;
    }

    function isValidFieldFund(data) {
      return data.keys().hasAll(['subId', 'tanggal', 'notaNo', 'items', 'totalNota', 'createdAt']) &&
             data.subId is string && isValidId(data.subId) &&
             data.tanggal is string &&
             data.notaNo is string &&
             data.items is list &&
             data.totalNota is number &&
             data.createdAt is number;
    }

    function isValidReportTemplate(data) {
      return data.keys().hasAll(['subId', 'heading', 'footer']) &&
             data.subId is string && isValidId(data.subId) &&
             data.heading is string &&
             data.footer is string;
    }

    // 3. COLLECTIONS
    match /mainMaterials/{id} {
      allow read, write: if true;
    }

    match /fieldFunds/{fundId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidFieldFund(incoming()) && isValidId(fundId);
      allow update: if isSignedIn() && isValidFieldFund(incoming());
      allow delete: if isSignedIn();
    }

    match /reportTemplates/{templateId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidReportTemplate(incoming()) && isValidId(templateId);
      allow update: if isSignedIn() && isValidReportTemplate(incoming());
      allow delete: if isSignedIn();
    }

    // Collection Group Security
    match /{path=**}/rapData/{itemId} {
      allow read: if isSignedIn();
    }

    match /profiles/{profileId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidProfile(incoming()) && isValidId(profileId);
      allow update: if isSignedIn() && isValidProfile(incoming());
      allow delete: if isSignedIn();
    }

    match /subs/{subId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidSub(incoming()) && isValidId(subId);
      allow update: if isSignedIn() && isValidSub(incoming());
      allow delete: if isSignedIn();

      match /stock/{stockId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn() && isValidStock(incoming()) && isValidId(stockId);
      }

      match /rapData/{itemId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn() && isValidRAPItem(incoming()) && isValidId(itemId);
      }
    }

    match /requests/{requestId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidMaterialRequest(incoming()) && isValidId(requestId);
      allow update: if isSignedIn() && isValidMaterialRequest(incoming());
      allow delete: if isSignedIn();
    }

    match /notifications/{notificationId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidNotification(incoming()) && isValidId(notificationId);
      allow update: if isSignedIn() && isValidNotification(incoming());
      allow delete: if isSignedIn();
    }
  }
}
